    {
      "parameters": {
        "jsCode": "const current = $('驗證身分並整理資料').all().map(x => x.json).filter(x => x.route === 'record_write');\nconst previous = $('查詢前日同項目紀錄（待接線）').all().map(x => x.json);\nconst defs = $('讀取追蹤項目定義').all().map(x => x.json);\nconst settings = $('讀取家庭追蹤設定').all().map(x => x.json);\nconst members = $('讀取家庭成員').all().map(x => x.json);\nconst first = current[0] || {};\nconst num = v => v === '' || v === null || v === undefined || !Number.isFinite(Number(v)) ? null : Number(v);\nconst warnings = [];\nfor (const row of current) {\n  const def = defs.find(x => String(x.metricKey) === String(row.metricKey)) || {};\n  const opts = settings.filter(x => String(x.familyId) === String(row.familyId) && String(x.metricKey) === String(row.metricKey)).sort((a,b)=>String(b.updatedAt||'').localeCompare(String(a.updatedAt||'')))[0] || {};\n  const prior = previous.find(x => String(x.metricKey) === String(row.metricKey) && String(x.period) === String(row.period) && String(x.memberId || x.lineUid) === String(row.memberId || row.lineUid));\n  if (!prior) continue;\n  const bp = String(row.metricKey) === 'blood_pressure' || String(def.inputType) === 'bloodPressure';\n  const fields = bp ? [['valueSystolic','systolicChangeThreshold','收縮壓'],['valueDiastolic','diastolicChangeThreshold','舒張壓']] : [['valueNumeric','changeThreshold',row.metricName || row.metricKey]];\n  for (const [valueField, thresholdField, label] of fields) {\n    const now = num(row[valueField] ?? (bp ? String(row.value||'').split('/')[valueField==='valueSystolic'?0:1] : row.value));\n    const before = num(prior[valueField] ?? (bp ? String(prior.value||'').split('/')[valueField==='valueSystolic'?0:1] : prior.value));\n    const threshold = num(opts[thresholdField]);\n    if (now === null || before === null || threshold === null) continue;\n    const delta = now - before;\n    if (Math.abs(delta) >= threshold) warnings.push({ metricKey: row.metricKey, metricName: row.metricName, label, previous: before, current: now, delta, threshold, unit: row.unit || '', period: row.period, recordDate: row.recordDate, memberId: row.memberId, recordId: row.recordId, familyId: row.familyId });\n  }\n}\nconst recipients = warnings.length ? [...new Set([String(first.lineUid || ''), ...members.filter(m => String(m.familyId || '') === String(first.familyId || '') && String(m.role || '').toLowerCase() === 'admin').map(m => String(m.lineUid || ''))].filter(Boolean))] : [];\nconst alertRows = warnings.map(w => ({ json: { alertId: w.recordId + '-' + w.metricKey, familyId: w.familyId, memberId: w.memberId, recordId: w.recordId, previousRecordId: '', metricKey: w.metricKey, metricName: w.metricName, alertType: 'two_day_change', period: w.period, recordDate: w.recordDate, previousValue: w.previous, currentValue: w.current, difference: w.delta, threshold: w.threshold, unit: w.unit, notificationStatus: 'queued', notificationAt: '', createdAt: new Date().toISOString() } }));\nreturn [{ json: { statusCode: 200, response: { ok: true, savedCount: current.length, recordedAt: first.recordedAt || new Date().toISOString(), recordDate: first.recordDate || '', period: first.period || '', warnings }, recipients, alertRows } }];"
      },
