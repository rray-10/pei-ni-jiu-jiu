    {
      "parameters": {
        "jsCode": "const items=$('驗證身分並整理資料').all().filter(x=>x.json.route==='update_write').map(x=>x.json); if(!items.length)return[{json:{statusCode:500,response:{ok:false,error:'設定更新失敗'}}}]; const settings=Object.fromEntries(items.map(x=>[x.metricKey,x.enabled])); const defs=new Map($('讀取追蹤項目定義').all().map(x=>x.json).map(d=>[String(d.metricKey),d])); const metrics=items.map(item=>{const m={metricKey:item.metricKey,metricName:item.metricName,inputType:String(defs.get(item.metricKey)?.inputType||'number'),unit:item.unit||'',isActive:true,thresholdsSaved:true}; for(const f of ['alertLow','alertHigh','systolicLow','systolicHigh','diastolicLow','diastolicHigh','changeThreshold','systolicChangeThreshold','diastolicChangeThreshold']){const value=item[f];m[f]=value!==''&&value!==null&&value!==undefined&&Number.isFinite(Number(value))?Number(value):null;} return m;}); return[{json:{statusCode:200,response:{ok:true,familyId:items[0].familyId,role:'admin',metrics,settings}}}];"
      },
