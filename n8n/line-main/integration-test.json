      "name": "確認單一成員",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "jsCode": "const input = $input.all();\nconst groups = new Map();\nfor (let i = 0; i < input.length; i++) {\n  const original = $('Code in JavaScript').itemMatching(i).json;\n  const key = original.event.webhookEventId || original.replyToken;\n  if (!groups.has(key)) groups.set(key,{original, rows:[], i});\n  if (input[i].json.lineUid === original.lineUid && input[i].json.familyId) groups.get(key).rows.push(input[i].json);\n}\nreturn [...groups.values()].map(({original,rows,i}) => ({\n  json:{...original, familyId:rows.length === 1 ? rows[0].familyId : ''},\n  pairedItem:{item:i}\n}));"
      }
    },
    {
      "id": "bdca1e02-cb57-4602-89dd-36abb2e405a0",
      "name": "傳遞完整 LINE Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        460
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => ({\n  json:{familyId:item.json.familyId,body:{events:[item.json.event]}},\n  pairedItem:{item:index}\n}));"
      }
    },
