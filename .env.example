# Copy to .env (never commit). GAS values live in Script Properties, not in files.
# --- GAS Script Properties (set in Apps Script editor > Project Settings) ---
F1_SPREADSHEET_ID=
APPT_SPREADSHEET_ID=
LINE_LOGIN_CHANNEL_ID=        # public Channel ID (used as client_id for ID token verify)
LIFF_ID=
DEV_AUTH_ENABLED=false        # true ONLY on a private test deployment
DEV_LINE_UID=                 # fictional test UID, used only when DEV_AUTH_ENABLED=true
NAV_DAILY_URL=
NAV_MEMBER_URL=
NAV_MEDICATION_URL=
# --- n8n (set in n8n Credentials UI, never in JSON) ---
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
